# --- Core ---
STEGOCHAT_ENVIRONMENT=development
STEGOCHAT_DEBUG=true
STEGOCHAT_HOST=0.0.0.0
STEGOCHAT_PORT=8000

# --- Security (CHANGE IN PRODUCTION) ---
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
STEGOCHAT_SECRET_KEY=dev-insecure-change-me-in-production-000000000000
STEGOCHAT_ACCESS_TOKEN_EXPIRE_MINUTES=30
STEGOCHAT_REFRESH_TOKEN_EXPIRE_DAYS=14

# --- Database ---
# SQLite (default, zero-config):
STEGOCHAT_DATABASE_URL=sqlite:///./stegochat.db
# PostgreSQL (production) — install psycopg first (see requirements.txt):
# STEGOCHAT_DATABASE_URL=postgresql+psycopg://stego:stego@localhost:5432/stegochat

# --- CORS (JSON array) ---
STEGOCHAT_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# --- Uploads ---
STEGOCHAT_MAX_UPLOAD_BYTES=10485760

# --- Email delivery (Brevo SMTP preferred; Gmail API remains supported) ---
STEGOCHAT_SMTP_HOST=smtp-relay.brevo.com
STEGOCHAT_SMTP_PORT=587
STEGOCHAT_SMTP_USE_SSL=false
STEGOCHAT_SMTP_USER=YOUR_BREVO_SMTP_LOGIN
STEGOCHAT_SMTP_PASSWORD=YOUR_NEW_BREVO_SMTP_KEY
STEGOCHAT_MAIL_FROM=stegochat232@gmail.com
# Optional local-only console transport. When enabled in development, OTPs are
# printed to the backend terminal. Never enable this in production.
# STEGOCHAT_DEV_MAIL_ENABLED=true

# Gmail API OAuth is used if SMTP is not configured:
# STEGOCHAT_GMAIL_CLIENT_ID=
# STEGOCHAT_GMAIL_CLIENT_SECRET=
# STEGOCHAT_GMAIL_REFRESH_TOKEN=
