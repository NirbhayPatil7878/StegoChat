# Docker Compose environment. Copy to `.env` and edit before `docker compose up`.

# --- REQUIRED: generate a strong secret ---
# python -c "import secrets; print(secrets.token_urlsafe(48))"
STEGOCHAT_SECRET_KEY=change-me-to-a-long-random-string

# --- Postgres ---
POSTGRES_USER=stego
POSTGRES_PASSWORD=stego
POSTGRES_DB=stegochat

# --- Web ---
WEB_PORT=8080
